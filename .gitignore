# Build artifacts
**/target/
**/build/
**/build-cuda/
**/cmake-build-*/
**/*.o
**/*.obj
**/*.a
**/*.lib
**/*.so
**/*.dylib
**/*.dll
**/*.exe
**/*.pdb
**/*.ilk

# Go
**/vendor/
api/bin/
/bin/
bindings/go/*.exe

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Models & generated data (never commit weights)
models/**
!models/README.md
*.safetensors
*.bin
*.gguf
*.forge
*.pt
*.pth
*.onnx

# Secrets (never commit)
.env
.env.*
!**/.env.example

# Local deployment output and cache
/.forge-deploy-out/
/.forge/

# Local benchmark output stays outside the harness source tree.
/benchmark-output/
*.prof
*.log
*.nsys-rep
*.nsys-rep.zip

# Python reference environment and generated activations
.venv/
.ruff_cache/
.pytest_cache/
__pycache__/
*.pyc

# Small numerical regression fixtures (not model weights).
!runtime/tests/fixtures/*.bin

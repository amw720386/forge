# Build artifacts
**/target/
**/build/
**/build-cuda/
**/cmake-build-*/
**/*.o
**/*.obj
**/*.a
**/*.lib
**/*.so
**/*.dylib
**/*.dll
**/*.exe
**/*.pdb
**/*.ilk

# Go
**/vendor/
api/bin/
bin/
bindings/go/*.exe

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Models & generated data (never commit weights)
models/**
!models/.gitkeep
!models/README.md
*.safetensors
*.bin
*.gguf
*.forge
*.pt
*.pth
*.onnx

# Secrets (never commit)
.env
.env.*
!**/.env.example

# Local Lightning session metadata (no secrets, but machine-local)
configs/cloud/.forge-cloud-state.json
.forge/
.forge-deploy-out/

# Local benchmark runs; reviewed historical evidence remains versioned.
benchmarks/results/local/
*.prof
*.log
!benchmarks/results/phase*/*.log
*.nsys-rep
*.nsys-rep.zip

# Python reference environment and generated activations
.venv/
__pycache__/
*.pyc

# Retired cloud session metadata
**/.forge-cloud-state.json

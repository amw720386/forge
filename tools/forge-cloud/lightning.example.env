# Copy to a local .env that is NOT committed.
# Official Lightning AI Go SDK auth:
#   https://github.com/Lightning-AI/sdk/blob/main/go/README.md

LIGHTNING_USER_ID=
LIGHTNING_API_KEY=

# Teamspace (required for Studio start/exec/stop)
FORGE_CLOUD_ORG=
FORGE_CLOUD_TEAMSPACE=
FORGE_CLOUD_STUDIO=forge-gpu

# Cost controls (Phase 8A)
FORGE_CLOUD_MACHINE=l4
FORGE_CLOUD_SPEND_LIMIT_USD=3
FORGE_CLOUD_MAX_SESSION=30m
FORGE_CLOUD_AUTO_SLEEP_MIN=15
FORGE_CLOUD_REQUIRE_CONFIRM=1

# Optional rate overrides (USD/hour planning estimates)
# FORGE_CLOUD_RATE_L4_USD=0.65

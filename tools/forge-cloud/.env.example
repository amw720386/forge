# Copy to `.env` at the repository root (never commit `.env`).
# Precedence: process environment > .env file > built-in defaults.
# forge-cloud also accepts: --env-file path/to/.env

# Required — Lightning AI (avatar → Global Settings → Keys)
LIGHTNING_USER_ID=
LIGHTNING_API_KEY=

# Required for Studio start/exec/stop
FORGE_CLOUD_ORG=
FORGE_CLOUD_TEAMSPACE=

# Optional Studio identity
FORGE_CLOUD_STUDIO=forge-gpu

# Cost / session controls
FORGE_CLOUD_MACHINE=l4
FORGE_CLOUD_SPEND_LIMIT_USD=3
FORGE_CLOUD_MAX_SESSION=30m
FORGE_CLOUD_AUTO_SLEEP_MIN=15
FORGE_CLOUD_REQUIRE_CONFIRM=1

# Optional: remote checkout path used by benchmark scripts
# FORGE_CLOUD_REMOTE_DIR=~/forge

# Optional rate overrides (USD/hour planning estimates only)
# FORGE_CLOUD_RATE_L4_USD=0.65
